# Dependencies
career-ops/node_modules/

# === PERSONDATA (PII) ===

# Personal config (phone, email, salary)
career-ops/config/profile.yml

# Context file (personnummer, fullständig historik)
career-ops/*_kontext_claude_code.md

# CV-filer (alla format - PDF, DOCX)
career-ops/cv.md
*.pdf
*.docx

# Generated output (CV:n, personliga brev)
career-ops/output/

# Utvärderingsrapporter med kontaktuppgifter
career-ops/reports/

# career-ops tracker-rader (en rad per utvärdering = persondata), även merged/ och archived/
career-ops/batch/tracker-additions/**/*.tsv

# STAR-historier och interview-prep (persondata om din karriär)
career-ops/interview-prep/

# career-ops egen genererade pipeline-vy (kan innehålla persondata)
career-ops/data/pipeline.html

# Sekretessregler (NDA m.m.) - FÅR ALDRIG COMMITTAS
CLAUDE.local.md

# Personliga brev/CV i alla format (fångar även .txt)
*_CV_*
*_Brev_*

# Din riktiga jobbpipeline (persondata) - se pipeline.example.html för formatet
pipeline.html
pipeline.html.bak*
pipeline.html.corrupted

# Personlig statusfil/arbetslogg
CURRENT_STATE.md

# Engångs-fixskript med hårdkodad persondata - använd af-mcp/pipeline_lib.py istället
update_pipeline.py

# HTML-rapporter (persondata - hela mappen ignoreras)
reports/

# Lokala Claude Code-inställningar (skills committas, bara lokala settings ignoreras)
/.claude/settings.local.json
career-ops/.claude/settings.local.json

# Python cache
__pycache__/
*.pyc

# === ÖVRIGT ===

# OS files
.DS_Store
Thumbs.db

# LibreOffice tempfiler och låsfiler
.~lock.*
*.tmp
lu*.tmp

# Environment
.env
.env.*
